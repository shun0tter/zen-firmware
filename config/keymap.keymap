#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        MKP_LCLK {
            bindings = <&mkp LCLK>;
            key-positions = <19 20>;
        };

        MKP_RCLK {
            bindings = <&mkp RCLK>;
            key-positions = <20 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB    &kp Q         &kp W  &kp E  &kp R         &kp T  &kp Y             &kp U           &kp I  &kp O  &kp P      &kp BSPC
&kp LCTRL  &kp A         &kp S  &kp D  &kp F         &kp G  &kp H             &kp J           &kp K  &kp L  &kp MINUS  &kp ENTER
&kp LSHFT  &kp Z         &kp X  &kp C  &kp V         &kp B  &kp INT_MUHENKAN  &kp INT_HENKAN  &kp N  &kp M  &kp COMMA  &kp DOT    &kp QUESTION  &kp RSHFT
&mo 2      &kp LEFT_GUI  &none  &none  &kp LEFT_ALT  &mo 1  &kp SPACE         &mo 2           &none  &none  &none      &mo 1
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE  &kp LS(N1)      &kp LS(N2)    &kp LS(N3)  &kp LS(MINUS)  &kp LS(SQT)  &kp LS(N8)     &kp LS(N9)      &kp RBKT        &kp NON_US_HASH      &kp INT_RO  &kp DEL
&trans      &kp LS(N6)      &kp LS(N7)    &kp LS(N4)  &kp LS(SEMI)   &kp SLASH    &kp LS(COMMA)  &kp LS(PERIOD)  &kp LS(RBKT)    &kp LS(NON_US_HASH)  &kp SQT     &trans
&trans      &kp LS(INT_YEN)  &kp LS(LBKT)  &kp LS(N5)  &kp LS(MINUS)  &kp LS(EQUAL)  &trans        &trans          &kp LS(SLASH)  &kp LS(INT_RO)       &kp EQUAL   &kp LBKT  &kp SEMI  &trans
&mo 3       &trans           &trans             &trans       &trans     &trans        &trans                &mo 3                  &trans            &trans             &trans         &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE  &kp N1  &kp N2    &kp N3       &kp N4         &kp N5   &kp N6    &kp N7    &kp N8        &kp N9           &kp N0  &kp DELETE
&trans      &trans  &kp HOME  &kp PAGE_UP  &kp PAGE_DOWN  &kp END  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans      &kp F1  &kp F2    &kp F3       &kp F4         &kp F5   &trans    &trans    &kp F6        &kp F7           &kp F8  &kp F9      &kp F10  &trans
&trans      &trans  &trans    &trans       &trans         &mo 3    &trans    &trans    &trans        &trans           &trans  &mo 3
            >;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 1    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 2    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans  &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
